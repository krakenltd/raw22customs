{% liquid
  assign target_link = section.settings.link | default: routes.all_products_collection_url
  assign theme_class = 'raw-section--dark'
  if section.settings.theme == 'paper'
    assign theme_class = 'raw-section--paper'
  endif
%}

<section class="raw-section {{ theme_class }}" aria-labelledby="RawEditorial-{{ section.id }}">
  <div class="raw-editorial{% if section.settings.reverse %} raw-editorial--reverse{% endif %}">
    <div class="raw-editorial__media">
      {% render 'raw-brand-media',
        image: section.settings.image,
        asset_name: section.settings.fallback_asset,
        alt: section.settings.image_alt,
        sizes: '(min-width: 990px) 62vw, 100vw'
      %}
      <span class="raw-editorial__index">{{ section.settings.index | escape }}</span>
    </div>
    <div class="raw-editorial__content">
      {% if section.settings.eyebrow != blank %}<p class="raw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="RawEditorial-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.copy != blank %}<div class="raw-editorial__copy">{{ section.settings.copy }}</div>{% endif %}
      {% if section.settings.show_steps %}
        <div class="raw-editorial__steps" aria-label="{{ section.settings.steps_label | escape }}">
          {% for i in (1..4) %}
            {% assign step_key = 'step_' | append: i %}
            {% if section.settings[step_key] != blank %}<span>0{{ i }} / {{ section.settings[step_key] | escape }}</span>{% endif %}
          {% endfor %}
        </div>
      {% endif %}
      {% if section.settings.button_label != blank %}<a class="raw-button{% if section.settings.theme == 'dark' %} raw-button--outline{% endif %}" href="{{ target_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RAW editorial split",
  "settings": [
    { "type": "select", "id": "theme", "label": "Colour treatment", "default": "dark", "options": [{ "value": "dark", "label": "Dark" }, { "value": "paper", "label": "Warm paper" }] },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "text", "id": "index", "label": "Index label", "default": "RAW / SERVICE 01" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CUSTOM BUILDS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "YOUR BIKE. YOUR WAY." },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Frame. Fork. Bars. Wheels. Every detail considered around how you ride.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "BUILD YOUR BMX" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "RAW Customs BMX" },
    {
      "type": "select",
      "id": "fallback_asset",
      "label": "Bundled fallback image",
      "default": "raw-bike-graphite.jpg",
      "options": [
        { "value": "raw-bike-graphite.jpg", "label": "Graphite BMX" },
        { "value": "raw-bike-blue.jpg", "label": "Blue BMX" },
        { "value": "raw-apparel-lookbook.jpg", "label": "Dark apparel lookbook" },
        { "value": "raw-apparel-vintage.jpg", "label": "Vintage apparel range" },
        { "value": "raw-backpack-dark.jpg", "label": "Dark backpack" }
      ]
    },
    { "type": "checkbox", "id": "show_steps", "label": "Show four steps", "default": true },
    { "type": "text", "id": "steps_label", "label": "Steps accessibility label", "default": "Build process" },
    { "type": "text", "id": "step_1", "label": "Step 1", "default": "DIRECTION" },
    { "type": "text", "id": "step_2", "label": "Step 2", "default": "FRAME" },
    { "type": "text", "id": "step_3", "label": "Step 3", "default": "COMPONENTS" },
    { "type": "text", "id": "step_4", "label": "Step 4", "default": "FINISH" }
  ],
  "presets": [{ "name": "RAW editorial split" }]
}
{% endschema %}
