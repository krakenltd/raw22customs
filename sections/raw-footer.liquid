<footer class="raw-footer">
  <div class="raw-shell raw-footer__top">
    <div class="raw-footer__brand">
      <a class="raw-footer__brandmark" href="{{ routes.root_url }}" aria-label="RAW Customs home">RAW<em>/22</em></a>
      {% if section.settings.copy != blank %}<div>{{ section.settings.copy }}</div>{% endif %}
    </div>

    {% for block in section.blocks %}
      {% if block.type == 'menu' %}
        <nav aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading | escape }}</h3>
          {% if block.settings.menu != blank %}
            <ul>
              {% for link in block.settings.menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          {% elsif request.design_mode %}
            <p>Select a Shopify menu for this column.</p>
          {% endif %}
        </nav>
      {% endif %}
    {% endfor %}
  </div>

  <div class="raw-shell raw-footer__bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }} / BUILT TO BE RIDDEN.</span>
    {% if shop.policies.size > 0 %}
      <nav class="raw-footer__policies" aria-label="Legal">
        {% for policy in shop.policies %}
          {% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}
        {% endfor %}
      </nav>
    {% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "RAW footer",
  "limit": 1,
  "settings": [
    { "type": "richtext", "id": "copy", "label": "Brand copy", "default": "<p>BMX, parts and apparel with workshop grit and street purpose.</p>" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "SHOP" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RAW footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "SHOP" } },
        { "type": "menu", "settings": { "heading": "HELP" } },
        { "type": "menu", "settings": { "heading": "ABOUT" } }
      ]
    }
  ]
}
{% endschema %}
