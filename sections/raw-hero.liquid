{% liquid
  assign primary_link = section.settings.primary_link | default: routes.all_products_collection_url
  assign secondary_link = section.settings.secondary_link | default: routes.collections_url
%}

<section class="raw-section raw-section--dark raw-hero" aria-labelledby="RawHero-{{ section.id }}">
  <div class="raw-hero__media" aria-hidden="true">
    {% render 'raw-brand-media',
      image: section.settings.image,
      asset_name: 'raw-hero-bike.jpg',
      alt: '',
      class: 'raw-hero__image',
      loading: 'eager',
      fetchpriority: 'high',
      sizes: '100vw'
    %}
  </div>

  <div class="raw-shell raw-hero__grid">
    <div class="raw-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="raw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1 id="RawHero-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {% if section.settings.copy != blank %}
        <div class="raw-hero__copy">{{ section.settings.copy }}</div>
      {% endif %}
      <div class="raw-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="raw-button" href="{{ primary_link }}">{{ section.settings.primary_label | escape }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="raw-button raw-button--outline" href="{{ secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
        {% endif %}
      </div>
    </div>

    {% if section.settings.show_facts %}
      <div class="raw-hero__foot" aria-label="Store departments">
        {% for i in (1..3) %}
          {% liquid
            assign label_key = 'fact_' | append: i | append: '_label'
            assign value_key = 'fact_' | append: i | append: '_value'
          %}
          <div class="raw-hero__fact">
            {{ section.settings[label_key] | escape }}
            <strong>{{ section.settings[value_key] | escape }}</strong>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "RAW editorial hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "RAW CUSTOMS / EST. 2022" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "BUILT TO BE RIDDEN." },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>BMX, custom builds, parts and streetwear selected with purpose.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "SHOP BMX" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "SHOP PARTS" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "checkbox", "id": "show_facts", "label": "Show department labels", "default": true },
    { "type": "text", "id": "fact_1_label", "label": "Label 1", "default": "DEPARTMENT 01" },
    { "type": "text", "id": "fact_1_value", "label": "Value 1", "default": "BMX + BUILDS" },
    { "type": "text", "id": "fact_2_label", "label": "Label 2", "default": "DEPARTMENT 02" },
    { "type": "text", "id": "fact_2_value", "label": "Value 2", "default": "PARTS + COMPONENTS" },
    { "type": "text", "id": "fact_3_label", "label": "Label 3", "default": "DEPARTMENT 03" },
    { "type": "text", "id": "fact_3_value", "label": "Value 3", "default": "RAW / 22 APPAREL" }
  ],
  "presets": [{ "name": "RAW editorial hero" }]
}
{% endschema %}
