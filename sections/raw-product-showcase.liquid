{% liquid
  assign featured_collection = section.settings.collection | default: collections.all
  assign product_limit = section.settings.product_limit
%}

<section class="raw-section raw-product-showcase" aria-labelledby="RawProducts-{{ section.id }}">
  <div class="raw-shell">
    <header class="raw-section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="raw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 id="RawProducts-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      {% if featured_collection != blank %}<a class="raw-arrow-link" href="{{ featured_collection.url }}">{{ section.settings.link_label | escape }}</a>{% endif %}
    </header>

    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <ul class="raw-product-grid" role="list">
        {% for product in featured_collection.products limit: product_limit %}
          {% liquid
            assign first_variant = product.selected_or_first_available_variant
            assign secondary_image = product.images[1]
          %}
          <li class="raw-product-card">
            <a class="raw-product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 1000 | image_tag: widths: '300, 450, 600, 800, 1000', sizes: '(min-width: 990px) 25vw, 72vw', loading: 'lazy', class: 'raw-product-card__image raw-product-card__image--primary', alt: product.featured_image.alt | default: product.title }}
                {% if secondary_image != blank %}
                  {{ secondary_image | image_url: width: 1000 | image_tag: widths: '300, 450, 600, 800, 1000', sizes: '(min-width: 990px) 25vw, 72vw', loading: 'lazy', class: 'raw-product-card__image raw-product-card__image--secondary', alt: secondary_image.alt | default: product.title }}
                {% endif %}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'raw-product-card__placeholder' }}
              {% endif %}
              {% if product.available == false %}
                <span class="raw-product-card__badge">SOLD OUT</span>
              {% elsif product.compare_at_price_max > product.price %}
                <span class="raw-product-card__badge">SALE</span>
              {% endif %}
            </a>
            <div class="raw-product-card__info">
              {% if product.vendor != blank %}<p class="raw-product-card__vendor">{{ product.vendor | escape }}</p>{% endif %}
              <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              <div class="raw-product-card__bottom">
                <div class="raw-product-card__price">
                  {% if product.price_varies %}<span>FROM </span>{% endif %}
                  <span>{{ product.price | money }}</span>
                  {% if product.compare_at_price_max > product.price %}<s>{{ product.compare_at_price_max | money }}</s>{% endif %}
                </div>
                {% if product.has_only_default_variant and product.available %}
                  {% form 'product', product, class: 'raw-product-card__form' %}
                    <input type="hidden" name="id" value="{{ first_variant.id }}">
                    <button type="submit" name="add" aria-label="Add {{ product.title | escape }} to cart">+</button>
                  {% endform %}
                {% else %}
                  <a class="raw-product-card__choose" href="{{ product.url }}" aria-label="Choose options for {{ product.title | escape }}">→</a>
                {% endif %}
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% elsif request.design_mode %}
      <p>Select a collection with products to populate this section.</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "RAW product showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FRESH THROUGH THE DOOR" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "NEW IN." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "VIEW ALL" }
  ],
  "presets": [{ "name": "RAW product showcase" }]
}
{% endschema %}
