<section class="raw-section raw-section--dark raw-lookbook" aria-labelledby="RawLookbook-{{ section.id }}">
  <div class="raw-shell">
    <header class="raw-section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="raw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 id="RawLookbook-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      {% if section.settings.link_label != blank %}<a class="raw-arrow-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>{% endif %}
    </header>

    <div class="raw-lookbook__grid">
      {% for block in section.blocks %}
        {% liquid
          assign item_tag = 'div'
          if block.settings.link != blank
            assign item_tag = 'a'
          endif
        %}
        <{{ item_tag }} class="raw-lookbook__item"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
          {% render 'raw-brand-media',
            image: block.settings.image,
            asset_name: block.settings.fallback_asset,
            alt: block.settings.caption,
            sizes: '(min-width: 990px) 55vw, 100vw'
          %}
          {% if block.settings.caption != blank %}<span class="raw-lookbook__caption">{{ block.settings.caption | escape }}</span>{% endif %}
        </{{ item_tag }}>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RAW image lookbook",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "RAW / 22" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "AFTER THE SESSION." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "SHOP THE RANGE" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Lookbook image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "RAW CUSTOMS / BUILT DIFFERENT" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Bundled fallback image",
          "default": "raw-apparel-lookbook.jpg",
          "options": [
            { "value": "raw-apparel-lookbook.jpg", "label": "Charcoal full look" },
            { "value": "raw-apparel-vintage.jpg", "label": "Vintage apparel range" },
            { "value": "raw-clothing-lineup.jpg", "label": "Clothing lineup" },
            { "value": "raw-workwear-colours.jpg", "label": "Workwear colours" },
            { "value": "raw-shirts-lineup.jpg", "label": "T-shirt lineup" },
            { "value": "raw-backpack-dark.jpg", "label": "Backpack" },
            { "value": "raw-beanies-lineup.jpg", "label": "Beanie lineup" },
            { "value": "raw-caps-lineup.jpg", "label": "Cap lineup" },
            { "value": "raw-shoe-black.jpg", "label": "Black footwear" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RAW image lookbook",
      "blocks": [
        { "type": "image", "settings": { "caption": "RAW / 22 — MADE FOR AFTER THE SESSION", "fallback_asset": "raw-apparel-lookbook.jpg" } },
        { "type": "image", "settings": { "caption": "WORKWEAR / BUILT FOR DAILY USE", "fallback_asset": "raw-apparel-vintage.jpg" } },
        { "type": "image", "settings": { "caption": "CARRY / FIELD TESTED", "fallback_asset": "raw-backpack-dark.jpg" } },
        { "type": "image", "settings": { "caption": "HEADWEAR / MUTED TONES", "fallback_asset": "raw-beanies-lineup.jpg" } },
        { "type": "image", "settings": { "caption": "FOOTWEAR / LOW PROFILE", "fallback_asset": "raw-shoe-black.jpg" } }
      ]
    }
  ]
}
{% endschema %}
