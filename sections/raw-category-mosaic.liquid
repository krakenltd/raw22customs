<section class="raw-section raw-categories" aria-labelledby="RawCategories-{{ section.id }}">
  <div class="raw-shell">
    <header class="raw-section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="raw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 id="RawCategories-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      {% if section.settings.link_label != blank %}
        <a class="raw-arrow-link" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label | escape }}</a>
      {% endif %}
    </header>

    <div class="raw-category-grid">
      {% for block in section.blocks %}
        {% liquid
          assign card_link = block.settings.link
          if card_link == blank and block.settings.collection != blank
            assign card_link = block.settings.collection.url
          endif
          if card_link == blank
            assign card_link = routes.collections_url
          endif
        %}
        <a class="raw-category-card" href="{{ card_link }}" {{ block.shopify_attributes }}>
          <span class="raw-category-card__media">
            {% render 'raw-brand-media',
              image: block.settings.image,
              asset_name: block.settings.fallback_asset,
              alt: block.settings.title,
              sizes: '(min-width: 990px) 60vw, 82vw'
            %}
          </span>
          <span class="raw-category-card__number">0{{ forloop.index }}</span>
          <span class="raw-category-card__content">
            <span>
              <span class="raw-category-card__meta">{{ block.settings.kicker | escape }}</span>
              <h3>{{ block.settings.title | escape }}</h3>
            </span>
            <span aria-hidden="true">↗</span>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RAW category mosaic",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE CATALOGUE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FIND YOUR LINE." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "EXPLORE ALL" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Small label", "default": "SHOP DEPARTMENT" },
        { "type": "text", "id": "title", "label": "Title", "default": "BMX" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Custom link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Bundled fallback image",
          "default": "raw-bike-graphite.jpg",
          "options": [
            { "value": "raw-bike-graphite.jpg", "label": "Graphite BMX" },
            { "value": "raw-bike-olive.jpg", "label": "Olive BMX" },
            { "value": "raw-bike-blue.jpg", "label": "Blue BMX" },
            { "value": "raw-apparel-lookbook.jpg", "label": "Apparel lookbook" },
            { "value": "raw-shirts-lineup.jpg", "label": "T-shirt lineup" },
            { "value": "raw-backpack-dark.jpg", "label": "Backpack" },
            { "value": "raw-shoe-navy.jpg", "label": "Footwear" },
            { "value": "raw-trousers-rust.jpg", "label": "Workwear" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RAW category mosaic",
      "blocks": [
        { "type": "category", "settings": { "title": "BMX", "fallback_asset": "raw-bike-graphite.jpg" } },
        { "type": "category", "settings": { "title": "PARTS", "fallback_asset": "raw-bike-olive.jpg" } },
        { "type": "category", "settings": { "title": "CLOTHING", "fallback_asset": "raw-apparel-lookbook.jpg" } },
        { "type": "category", "settings": { "title": "FOOTWEAR", "fallback_asset": "raw-shoe-navy.jpg" } },
        { "type": "category", "settings": { "title": "RAW / 22", "fallback_asset": "raw-apparel-vintage.jpg" } },
        { "type": "category", "settings": { "title": "ACCESSORIES", "fallback_asset": "raw-backpack-dark.jpg" } }
      ]
    }
  ]
}
{% endschema %}
