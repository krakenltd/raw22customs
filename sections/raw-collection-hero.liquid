<section class="raw-collection-hero{% if collection.image != blank %} raw-collection-hero--has-image{% endif %}" aria-labelledby="RawCollectionTitle-{{ section.id }}">
  {% if collection.image != blank %}
    <div class="raw-collection-hero__media" aria-hidden="true">
      {{ collection.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 990px) 52vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
    </div>
  {% endif %}
  <div class="raw-shell raw-collection-hero__content">
    <p class="raw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 id="RawCollectionTitle-{{ section.id }}">{{ collection.title | escape }}</h1>
    {% if collection.description != blank %}<div class="raw-collection-hero__description rte">{{ collection.description }}</div>{% endif %}
    <p class="raw-collection-hero__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'PRODUCT', 'PRODUCTS' }}</p>
  </div>
</section>

{% schema %}
{
  "name": "RAW collection header",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "RAW CATALOGUE / COLLECTION" }
  ],
  "presets": [{ "name": "RAW collection header" }]
}
{% endschema %}
