{%- comment -%}
  Responsive merchant image with a bundled RAW reference fallback.
  Parameters: image, asset_name, alt, class, loading, sizes, fetchpriority.
{%- endcomment -%}
{%- liquid
  assign media_loading = loading | default: 'lazy'
  assign media_sizes = sizes | default: '100vw'
  assign media_alt = alt | default: ''
-%}
{%- if image != blank -%}
  {{ image
    | image_url: width: 2200
    | image_tag:
      widths: '360, 540, 720, 960, 1200, 1600, 2200',
      sizes: media_sizes,
      loading: media_loading,
      fetchpriority: fetchpriority,
      class: class,
      alt: media_alt
  }}
{%- elsif asset_name != blank -%}
  <img
    src="{{ asset_name | asset_url }}"
    alt="{{ media_alt | escape }}"
    class="{{ class }}"
    loading="{{ media_loading }}"
    {% if fetchpriority != blank %}fetchpriority="{{ fetchpriority }}"{% endif %}
    width="1600"
    height="1067"
  >
{%- endif -%}
